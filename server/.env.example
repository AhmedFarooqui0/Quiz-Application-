MONGO_URI=
PORT=5000

# Used to sign login sessions (JWTs). Use a long random string in production.
JWT_SECRET=replace_this_with_a_long_random_string

# Base URL the server uses to build links (e.g. in verification emails).
CLIENT_URL=localhost_url
# Gmail SMTP credentials for sending verification emails.
EMAIL_USER=EMAIL_USER
EMAIL_PASS=your_16_char_app_password